# Remote LLM (OpenAI-compatible). No leading spaces; values may be quoted.
REMOTE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
REMOTE_BASE_URL="https://api.deepseek.com"
# Use your provider's CURRENT model id. DeepSeek retired "deepseek-chat" and
# "deepseek-reasoner" in 2026 — check https://api-docs.deepseek.com for the
# current names (e.g. deepseek-v4-flash / deepseek-v4-pro).
REMOTE_MODEL_NAME="deepseek-v4-flash"

# Local LLM server (e.g. LM Studio / vLLM). API key is not needed.
LOCAL_BASE_URL="http://localhost:8000/v1"
LOCAL_MODEL_NAME="deepseek/deepseek-r1-0528-qwen3-8b"
