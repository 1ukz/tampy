# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets & local configuration
.env

# TAMPY runtime output: logs, HAR, recorded flows, analysis, and the
# local secret-redaction maps (these contain real credentials — never commit).
.logs/

# Generated replay modules (built from recordings at replay time). These are
# written next to the recorded actions under .logs/ (already ignored above);
# keep this pattern specific so it never matches source like core/http_replay.py.
*_actions_replay.py

# OS cruft
.DS_Store
Thumbs.db
